rules_version = '2';

// Open access: no sign-in required. Anyone who has the app link (or the project id)
// can read, change and delete items, offers and settings.
// To lock it down later, set requireSignIn = true in js/config.js and use the
// allow-list version described in README.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /items/{id} {
      allow read, write: if true;
    }
    match /offers/{id} {
      allow read, write: if true;
    }
    match /meta/{id} {
      allow read, write: if true;
    }
  }
}
